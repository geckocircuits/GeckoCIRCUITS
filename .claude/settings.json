{
  "permissions": {
    "allow": [
      "Bash(chmod *)",
      "Bash(export *)",
      "Bash(export PATH=~/apache-maven-3.9.5/bin:$PATH)",
      "Bash(find *)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(grep *)",
      "Bash(java *)",
      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(ls:*)",
      "Bash(mkdocs:*)",
      "Bash(mvn *)",
      "Bash(mvn:*)",
      "Bash(python3 *)",
      "Bash(sed *)",
      "Bash(snap *)",
      "Bash(tar *)",
      "Bash(tree *)",
      "Bash(tree:*)",
      "Bash(wc *)",
      "Bash(wc:*)",
      "Bash(xargs cat *)",
      "Bash(~/apache-maven-3.9.5/bin/mvn --version)",
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "Write"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/tinix/claude_wsl/agents_pool/hooks/post-commit-remind.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/tinix/claude_wsl/agents_pool/hooks/post-tool-regen-docs.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/tinix/claude_wsl/agents_pool/hooks/post-tool-build-mkdocs.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
